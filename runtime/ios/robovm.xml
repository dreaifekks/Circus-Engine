<config>
  <executableName>DCRuntime</executableName>
  <mainClass>org.circus.ios.GameMain</mainClass>
  <os>ios</os>
  <target>ios</target>
  <iosInfoPList>Info.plist.xml</iosInfoPList>
  <treeShaker>conservative</treeShaker>
  <resources><resource><directory>resources</directory></resource></resources>
  <forceLinkClasses><pattern>org.circus.ios.**</pattern><pattern>com.android.org.conscrypt.**</pattern></forceLinkClasses>
  <libs><lib>native/libcircus.a</lib></libs>
  <exportedSymbols><symbol>circus_*</symbol></exportedSymbols>
  <frameworks><framework>AVFoundation</framework><framework>CoreText</framework><framework>CoreGraphics</framework><framework>UIKit</framework><framework>Foundation</framework></frameworks>
</config>
